# Supabase project URL and anon (publishable) key — safe for client-side use
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never expose to the client.
# Only needed if you add server-side admin operations that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for metadata, sitemap, and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
